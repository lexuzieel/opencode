# Deployment settings for the OpenCode web UI.
# Copy to .env on the server and adjust. No secrets here; the password lives
# in login.txt (git-ignored).

# Public URL of the web UI, scheme included.
PUBLIC_URL=https://code.aleksei.dev

# Interface and port the standalone web server binds to. The address must be
# reachable from the nginx-proxy-manager container and NOT from the internet.
# On another server find it with:
#   docker network inspect gateway --format '{{(index .IPAM.Config 0).Gateway}}'
WEB_HOST=172.23.0.1
WEB_PORT=49375

# Password file (relative to this directory or absolute).
WEB_ACCESS_FILE=login.txt
