# Deployment settings for the OpenCode stack.
# Copy to .env on the server and adjust. No secrets here; the web password
# lives in password.txt (git-ignored).

# Public URL of the web UI, scheme included.
PUBLIC_URL=https://code.example.com

# Public base URL of the file dump, scheme included, no trailing slash.
SHARE_URL=https://files.example.com

# Where share.sh keeps files. Default: share/ next to the scripts.
# SHARE_ROOT=/srv/share

# Interface and port the standalone web server binds to. The address must be
# reachable from the proxy container and NOT from the internet. 127.0.0.1 is
# the safe default when the proxy runs on the host; for a containerised proxy
# use the gateway of the shared docker network:
#   docker network inspect gateway --format '{{(index .IPAM.Config 0).Gateway}}'
WEB_HOST=172.23.0.1
WEB_PORT=49375

# Password file (relative to this directory or absolute). Rewrite it with
# ./web.sh passwd, which generates the password and keeps the file at 0600.
WEB_ACCESS_FILE=password.txt
